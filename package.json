{
  "name": "beat-note",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "prepare-files": "node scripts/prepare.ts",
    "predev": "npm run -s prepare-files",
    "dev": "next dev",
    "prebuild": "npm run -s prepare-files",
    "build": "next build",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --test 'tests/**/*.test.ts'",
    "template": "node scripts/template-hash.ts",
    "e2e": "node --test 'tests/e2e/*.e2e.ts'",
    "scores": "node scripts/make-scores.ts",
    "measure": "node scripts/measure.ts",
    "measure:local": "node scripts/measure-local.ts"
  },
  "dependencies": {
    "next": "16.4.6",
    "onnxruntime-web": "1.31.1",
    "pdfjs-dist": "6.5.438",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@fontsource/gowun-dodum": "5.3.0",
    "@fontsource/nanum-gothic": "5.3.0",
    "@fontsource/nanum-myeongjo": "5.3.0",
    "@fontsource/nanum-pen-script": "5.3.0",
    "@fontsource/noto-sans-kr": "5.3.1",
    "@napi-rs/canvas": "1.2.1",
    "@types/node": "24.19.3",
    "@types/react": "19.3.1",
    "@types/react-dom": "19.3.0",
    "playwright": "1.65.1",
    "typescript": "7.0.2",
    "verovio": "6.4.1"
  }
}
